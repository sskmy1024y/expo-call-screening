<?xml version="1.0" encoding="utf-8"?>
<!--
  Background of the caller ID band.

  Semi-transparent so the incoming call screen stays readable behind it, and rounded so the band
  reads as a card rather than as a system bar.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle">
  <solid android:color="#CC1F2933" />
  <corners android:radius="12dp" />
</shape>
